NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://artisan:artisan@localhost:5432/artisan

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Termii SMS: 'mock' logs OTPs via pino instead of calling the Termii API.
# Use 'live' once you have a real API key.
TERMII_MODE=mock
TERMII_API_KEY=
TERMII_SENDER_ID=ArtisanHQ
TERMII_BASE_URL=https://api.ng.termii.com/api

# CORS — comma-separated origins for the web + mobile apps
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
